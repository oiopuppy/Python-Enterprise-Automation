# =============================================================================
# Git 属性配置 — 统一行尾风格
# =============================================================================

# 所有文本文件使用 LF 行尾
* text=auto eol=lf

# 二进制文件不做任何转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.xlsx binary
*.xls binary
*.pdf binary
*.zip binary
*.tar.gz binary

# Python 文件显式指定
*.py text eol=lf
*.toml text eol=lf
*.cfg text eol=lf
*.ini text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.sh text eol=lf
*.env text eol=lf
*.env.example text eol=lf
.gitignore text eol=lf
.dockerignore text eol=lf
Dockerfile text eol=lf
