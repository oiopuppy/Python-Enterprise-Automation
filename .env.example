# =============================================================================
# 保险理赔审计系统 — 环境变量配置
# Insurance Claim Audit System — Environment Configuration
# =============================================================================
# 复制此文件为 .env 并填入实际值
# Copy this file to .env and fill in actual values
# =============================================================================

# --- 应用基础配置 ---
APP_NAME=保险理赔审计系统
APP_ENV=development          # development | staging | production
APP_DEBUG=true               # true | false
APP_LOG_LEVEL=INFO           # DEBUG | INFO | WARNING | ERROR | CRITICAL
APP_LOG_FILE=logs/audit.log
APP_LOG_MAX_BYTES=10485760   # 10MB 单文件上限
APP_LOG_BACKUP_COUNT=30      # 保留30天的日志

# --- 数据文件路径 ---
DATA_INPUT_FILE=sample_claim_data.xlsx
DATA_OUTPUT_FILE=final_settlement_report.xlsx
DATA_OUTPUT_DIR=reports/

# --- 业务参数 ---
# 默认免赔额（元）—— 可在运行时覆盖
INSURANCE_DEFAULT_DEDUCTIBLE=500
# 默认赔付比例 —— 可在运行时覆盖
INSURANCE_DEFAULT_RATIO=0.80
# 金额精度（小数位数）
INSURANCE_DECIMAL_PLACES=2
# 年度累计赔付上限（元）
INSURANCE_ANNUAL_LIMIT=500000
# 保单前缀 —— 用于验证保单号格式
INSURANCE_POLICY_PREFIX=CL
# 最小报案金额（元）
INSURANCE_MIN_CLAIM_AMOUNT=0.01
# 最大报案金额（元）
INSURANCE_MAX_CLAIM_AMOUNT=99999999.99

# --- 安全配置 ---
# 生产环境必须设置强密钥
SECRET_KEY=change-me-in-production
# 加密开关（生产环境建议开启）
ENABLE_DATA_ENCRYPTION=false

# --- 审计追溯 ---
AUDIT_ENABLED=true
AUDIT_LOG_FILE=logs/audit_trail.log
